{
  "name": "treeschool",
  "private": true,
  "packageManager": "bun@1.2.5",
  "workspaces": [
    "app/*",
    "packages/*"
  ],
  "overrides": {
    "@tootallnate/once": "2.0.1",
    "fast-xml-builder": "1.3.0",
    "fast-xml-parser": "5.10.1",
    "flatted": "3.4.2",
    "form-data": "2.5.6",
    "js-yaml": "4.3.1",
    "postcss": "8.5.26",
    "sharp": "0.35.3",
    "shell-quote": "1.9.0",
    "uuid": "11.1.1"
  },
  "scripts": {
    "dev": "bun run --filter ts-frontend dev & bun run --filter ts-backend dev",
    "dev:frontend": "bun run --filter ts-frontend dev",
    "dev:backend": "bun run --filter ts-backend dev",
    "build": "bun run --filter ts-db build && bun run --filter ts-backend build && bun run --filter ts-frontend build",
    "lint": "bun run --filter ts-db lint && bun run --filter ts-frontend lint && bun run --filter ts-backend lint",
    "verify:plan-generators": "bun run --filter ts-frontend verify:plan-generators",
    "db:generate": "bash ./scripts/drizzle-node20.sh generate --config=drizzle.config.mjs",
    "db:push": "bash ./scripts/drizzle-node20.sh push --config=drizzle.config.mjs",
    "db:studio": "bash ./scripts/drizzle-node20.sh studio --config=drizzle.config.mjs",
    "db:seed:grades": "bun run scripts/seed-grade-nodes.ts",
    "db:seed:locales": "bun run scripts/seed-locales.ts",
    "db:seed:g1math": "bun run scripts/seed-g1-math.ts",
    "db:seed:g1commoncore": "bun run scripts/seed-g1-common-core.ts",
    "db:seed:g1texas": "bun run scripts/seed-g1-texas-science-social-studies.ts",
    "db:seed:electives": "bun run scripts/seed-electives.ts",
    "workbook-studio:import-prompts": "bun --env-file=app/ts-backend/.env run scripts/import-workbook-studio-prompts.ts",
    "stripe:sync:membership": "bun run scripts/stripe/sync-membership-plans.ts",
    "generate:migration": "bun run db:generate",
    "data-migrations:apply": "bun run db:push"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "dotenv": "^16.6.1",
    "drizzle-kit": "^0.30.6",
    "tsx": "^4.23.11",
    "typescript": "^5.9.3"
  }
}
