DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_APP_URL=https://dev.treehomeschool.com
NEXT_PUBLIC_APP_HOST=dev.treehomeschool.com
INTERNAL_BACKEND_URL=http://ts-backend:3001

# Workbook Studio AI generation (Anthropic Claude)
ANTHROPIC_API_KEY=sk-ant-your-key
# Optional. Leave unset to use the backend's pinned default model.
# WORKBOOK_STUDIO_MODEL=claude-sonnet-4-20250514

# Backend billing
BILLING_GUARD_ENABLED=false
STRIPE_SECRET_KEY=sk_test_your_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PLAN_PACK_PRICE_ID=price_your_plan_pack_price
STRIPE_MONTHLY_PRICE_ID=price_your_20_usd_monthly_price
STRIPE_YEARLY_PRICE_ID=price_your_200_usd_yearly_price
STRIPE_ADDITIONAL_STUDENT_MONTHLY_PRICE_ID=price_your_5_usd_monthly_additional_student_price
STRIPE_ADDITIONAL_STUDENT_YEARLY_PRICE_ID=price_your_50_usd_yearly_additional_student_price

# Native workbook purchase delivery (local Supabase Mailpit/Inbucket)
PUBLIC_APP_URL=https://dev.treehomeschool.com
SMTP_HOST=127.0.0.1
SMTP_PORT=54325
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Treeschool Support <support@treehomeschool.com>

# Production uses mail.privateemail.com:465 with SMTP_SECURE=true,
# SMTP_USER=support@treehomeschool.com, and SMTP_PASSWORD stored in Secret Manager.
